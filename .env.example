# ==============================================================================
# การตั้งค่าการเชื่อมต่อฐานข้อมูลโรงพยาบาลสำหรับ ERPLPH
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ไขค่าตามการเชื่อมต่อจริงของโรงพยาบาล
# ==============================================================================

# IP หรือ Hostname ของ SQL Server ฐานข้อมูลโรงพยาบาล
DB_HOST=172.16.0.33

# พอร์ตของ SQL Server (ค่าเริ่มต้น 1433)
DB_PORT=1433

# ชื่อฐานข้อมูลคลังยาและพัสดุ (เช่น SSBSTOCK)
DB_NAME=SSBSTOCK

# ผู้ใช้และรหัสผ่านสำหรับเชื่อมต่อฐานข้อมูล
DB_USER=sa
DB_PASS=

# รหัสสถานพยาบาล (เช่น EA0010672)
HOSP_CODE=EA0010672

# ==============================================================================
# การตั้งค่าระบบ Login และ Session
# ==============================================================================
# ระยะเวลาคงอยู่ของ Session (วินาที) — ค่าเริ่มต้น 28800 (8 ชั่วโมง)
# ERPLPH_SESSION_TTL_SECONDS=28800

# รหัสผ่านผู้ดูแลระบบสำรองเมื่อต่อฐานข้อมูลโรงพยาบาลไม่ได้ (คั่นด้วยคอมมา)
# ERPLPH_ADMIN_PASSWORD=ADMIN,STOCK5,1234,123456

# ปิดใช้งานบัญชี admin สำรองบนเซิร์ฟเวอร์จริง (1 = ปิด, 0 = เปิด)
# ERPLPH_DISABLE_OFFLINE_ADMIN=0
